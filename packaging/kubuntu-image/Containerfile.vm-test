FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        ovmf \
        python3 \
        python3-pip \
        python3-venv \
        qemu-system-x86 \
        qemu-utils \
        socat \
    && python3 -m venv /opt/vncdotool \
    && /opt/vncdotool/bin/pip install --no-cache-dir vncdotool==1.2.0 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/vncdotool/bin:${PATH}"
